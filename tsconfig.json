{
  "include": [
    "src/**/*",
    "index.ts",
    "__tests__",
    "____sample/**/*",
    ".eslintrc.js",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "es2016",
    "lib": ["ESNext"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "commonjs",
    "moduleResolution": "node10",
    "typeRoots": ["node_modules/@types"],
    "types": ["jest", "node"],
    "allowJs": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
